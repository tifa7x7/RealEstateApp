# =====================================================================
# Local development
# =====================================================================
# Copy this file to `.env.local` and fill in the values you need.
# Variables prefixed `NEXT_PUBLIC_*` ship to the browser; everything else
# is server-only. NEVER expose service-role keys to the browser.

# ---------------------------------------------------------------------
# Site URL — feeds into `metadataBase` + sitemap + OG URLs.
# Local dev: http://localhost:3000 (default if unset).
# Production: the canonical origin, e.g. https://real-estate-app.ru
# ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------
# Supabase — REQUIRED in production (boot-time assertion in
# src/lib/supabase/env.ts). Leave blank in dev to use the bundled
# seed (src/data/projects.ts) + localStorage stub auth.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for the billing webhook handler
# (/api/billing/webhook) and for admin scripts. NEVER expose to browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Billing — Phase 15 contract. Required when you're ready to accept
# real payments. Without these, /api/billing/checkout returns 501 and
# the UpgradePrompt surfaces a "оплата временно недоступна" toast.
# ---------------------------------------------------------------------
# One of: 'yookassa' | 'cloudpayments' | 'productboard'
BILLING_PROVIDER=
# Provider-specific API credentials — see your provider's docs.
BILLING_API_KEY=
# Used by /api/billing/webhook to verify provider signatures (HMAC).
BILLING_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Ads (optional) — set to enable real ad inventory in `<AdSlot>`
# components. With no provider, AdSlot renders nothing in production
# and a dashed outline in dev.
# ---------------------------------------------------------------------
NEXT_PUBLIC_AD_PROVIDER=
