# Copy this file to .env.local and fill in your Supabase project's keys.
# Leave blank to keep the app on the bundled seed data (src/data/projects.ts)
# and the localStorage-backed auth/favorites/calcs from Phases 1-7.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required only if you intend to run admin operations
# (project seeding, user impersonation). NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
